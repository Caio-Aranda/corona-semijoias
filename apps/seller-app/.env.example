# Copie este arquivo para ".env" nesta pasta (apps/seller-app) se precisar mudar algo.
# O ".env" nunca vai para o Git. Nada aqui é segredo.

# Endereço da API. Em desenvolvimento é a API deste computador (npm run api:run).
# Fora deste computador, o endereço precisa começar com https://.
MAIN_VITE_CORONA_API_URL=http://localhost:8080
