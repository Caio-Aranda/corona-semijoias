# Configuração de quem PUBLICA versão nova do Corona Vendas (npm run vendas:publicar).
# Copie para ".env.publicar" nesta pasta (apps/seller-app). O ".env.publicar" nunca vai para o Git.
# O acesso à VPS é por chave SSH (nada de senha aqui).

# Usuário e IP da VPS.
CORONA_VPS=root@203.0.113.10

# Arquivo da chave privada SSH, se não for a padrão do computador (opcional).
# CORONA_VPS_CHAVE=C:/Users/voce/.ssh/corona_vps

# Pasta das atualizações na VPS (opcional; este é o padrão).
# CORONA_VPS_PASTA=/srv/corona/atualizacoes
