# Configuração do INSTALADOR do Corona Vendas. Copie para ".env.producao" nesta pasta (apps/seller-app) e preencha.
# O ".env.producao" nunca vai para o Git. Nada aqui é segredo, mas os valores reais são só da instalação da dona.
# Veja deploy/certificado/README.md e docs/entrega-corona-gestao.md.

# Endereço do servidor (a VPS), pelo IP, com https:// e sem barra no fim.
MAIN_VITE_CORONA_API_URL=https://203.0.113.10

# Impressões digitais (SHA-256 da chave pública) do certificado do servidor: a ATUAL e a RESERVA, separadas
# por vírgula. Quem gera: "deploy/certificado/gerar-certificado.sh pin" (atual) e "... reserva <pasta>" (reserva).
MAIN_VITE_CORONA_API_PINS=sha256/AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=,sha256/BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB=
