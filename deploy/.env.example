# Copie este arquivo para ".env" NESTA pasta (deploy/) NO SERVIDOR, e troque os valores:
#   cp .env.example .env && chmod 600 .env
# O arquivo ".env" nunca vai para o Git. Todos os valores abaixo são falsos, só de exemplo.
# Gerar valores aleatórios (no servidor):   openssl rand -base64 32 | tr -d '=+/'   (letras e números, sem $)
#
# ATENÇÃO: não use o caractere $, a barra invertida nem aspas nas senhas (o Docker Compose lê $ como
# variável e a senha chega cortada, sem aviso). Use letras, números e - _ .

# --- Banco de dados (PostgreSQL, dentro do Compose; a porta NUNCA é aberta para a internet) ---
DB_NAME=corona
POSTGRES_USER=troque-isto
POSTGRES_PASSWORD=troque-isto
DB_MIGRACAO_USER=troque-isto
DB_MIGRACAO_PASSWORD=troque-isto
DB_APP_USER=troque-isto
DB_APP_PASSWORD=troque-isto

# --- Segurança (veja o .env.example da raiz para a explicação de cada uma) ---
JWT_CHAVE_ATUAL_ID=chave-1
JWT_CHAVE_ATUAL=troque-isto
JWT_CHAVE_ANTERIOR_ID=
JWT_CHAVE_ANTERIOR=
# Valor DIFERENTE das chaves JWT.
SESSAO_SEGREDO_RENOVACAO=troque-isto

# --- Primeiro administrador (a dona) ---
# Lidos só enquanto o banco não tem nenhum administrador. Na primeira entrada a dona é obrigada a criar
# a senha nova. DEPOIS DO PRIMEIRO ACESSO, apague ADMIN_SENHA daqui (a API não a lê mais).
ADMIN_NOME=troque-isto
ADMIN_LOGIN=troque-isto
ADMIN_SENHA=troque-isto

# --- Versão mínima dos aplicativos ---
APP_VERSAO_MINIMA_GESTAO=1.0.0
APP_VERSAO_MINIMA_VENDAS=1.0.0

# --- Pastas do servidor (já são os padrões; só mude se souber o motivo) ---
# Fotos e documentos enviados (entram no backup).
CORONA_PASTA_ARQUIVOS=/srv/corona/arquivos
# Certificado HTTPS (servidor.crt e servidor.key). Veja deploy/certificado/README.md.
CORONA_PASTA_CERTIFICADO=/etc/corona/tls
# Instaladores do Corona Gestão para a atualização automática.
CORONA_PASTA_ATUALIZACOES=/srv/corona/atualizacoes

# Porta HTTPS publicada. Em produção é 443 (o app da dona usa esta). Só mude para testar num computador.
PORTA_HTTPS=443
