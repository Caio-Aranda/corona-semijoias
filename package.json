{
  "name": "corona-semijoias",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Sistema de semijoias consignadas: Corona Gestão, Corona Vendas e API.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=26.13.0 <27",
    "npm": ">=11.20.0 <12"
  },
  "packageManager": "npm@11.20.0",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
