{
  "name": "corona-semijoias",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Sistema de semijoias consignadas: Corona Gestão, Corona Vendas e API.",
  "workspaces": [
    "apps/*",
    "packages/*",
    "testes-sync"
  ],
  "engines": {
    "node": ">=26.13.0 <27",
    "npm": ">=11.20.0 <12"
  },
  "packageManager": "npm@11.20.0",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p testes-e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "setup": "node scripts/setup.mjs",
    "setup:test": "node --test scripts/setup/",
    "owner:dev": "npm run dev -w @corona/owner-app",
    "owner:build": "npm run build -w @corona/owner-app",
    "owner:empacotar": "node scripts/empacotar-app.mjs --app=gestao",
    "owner:publicar": "node scripts/publicar-app.mjs --app=gestao",
    "vendas:empacotar": "node scripts/empacotar-app.mjs --app=vendas",
    "vendas:publicar": "node scripts/publicar-app.mjs --app=vendas",
    "scripts:test": "node --test scripts/lib/",
    "e2e": "playwright test -c testes-e2e/playwright.config.ts",
    "seller:dev": "npm run dev -w @corona/seller-app",
    "seller:build": "npm run build -w @corona/seller-app",
    "seller:empacotar": "npm run empacotar -w @corona/seller-app",
    "barreira:varrer": "node scripts/barreira/varrer-pacote.mjs",
    "api:run": "node scripts/mvnw.mjs spring-boot:run",
    "api:test": "node scripts/mvnw.mjs verify",
    "api:clientes": "node scripts/gerar-clientes.mjs",
    "api:redefinir-senha": "node scripts/redefinir-senha-admin.mjs",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "overrides": {
    "js-yaml": "4.3.2"
  }
}
