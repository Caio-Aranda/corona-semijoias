    "/api/vendedor/vendas" : {
      "get" : {
        "description" : "Só as vendas do vendedor logado, da mais nova para a mais antiga. Filtros opcionais por dia (de e até, no horário de Brasília), cliente e situação (CONCLUIDA ou ESTORNADA).",
