    "/api/auth/login" : {
      "post" : {
        "description" : "Devolve o token de acesso (15 minutos) e o de renovação (30 dias). O Corona Vendas manda dispositivoId; os outros aplicativos não. Depois de 5 erros seguidos do mesmo endereço, responde 429 com Retry-After até o fim do bloqueio.",
        "operationId" : "entrar",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/PedidoDeLogin"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/RespostaDoLogin"
                }
              }
            },
            "description" : "OK"
          }
        },
        "security" : [ ],
        "summary" : "Entrar com login e senha",
        "tags" : [ "autenticacao-controller" ]
      }
    },
    "/api/auth/renovar" : {
      "post" : {
        "description" : "Troca o token de renovação por um novo (o anterior deixa de valer) e devolve um token de acesso novo. Mande o mesmo dispositivoId do login. Não precisa do token de acesso.",
        "operationId" : "renovar",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/PedidoDeRenovacao"
