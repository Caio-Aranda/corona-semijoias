      },
      "post" : {
        "description" : "Baixa as peças da maleta do vendedor pelo preço congelado da remessa. O servidor recalcula subtotal, desconto e total; o desconto respeita o limite da dona. Pagamentos opcionais (venda a prazo grava só o que foi pago na hora). Mesmo id e mesmo conteúdo devolve 200; mesmo id com dados diferentes, 409.",
        "operationId" : "venderNaMaleta",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/PedidoDaVenda"
              }
            }
          },
          "required" : true
        },
        "responses" : {
