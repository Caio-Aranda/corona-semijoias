# Copie este arquivo para ".env" e troque os valores.
# O arquivo ".env" nunca vai para o Git. Todos os valores abaixo são falsos, só de exemplo.

# --- Banco de dados (PostgreSQL) ---

# Onde o banco está. Em desenvolvimento, é o container do Docker neste computador.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=corona

# Administrador do container do PostgreSQL. Usado só na criação inicial do banco.
POSTGRES_USER=troque-isto
POSTGRES_PASSWORD=troque-isto

# Usuário das migrações (Flyway). É o dono do schema: cria e altera tabelas.
DB_MIGRACAO_USER=troque-isto
DB_MIGRACAO_PASSWORD=troque-isto

# Usuário da aplicação (API). Não é superusuário e tem limite de 60 segundos por transação.
DB_APP_USER=troque-isto
DB_APP_PASSWORD=troque-isto

# --- Segurança ---

# Segredo que assina os tokens de acesso (JWT). Use um texto longo e aleatório.
JWT_SECRET=troque-isto-por-um-texto-longo-e-aleatorio

# --- Primeiro administrador ---

# Conta da dona criada na primeira vez que a API sobe com o banco vazio.
# Na primeira entrada ela precisa trocar esta senha.
ADMIN_NOME=troque-isto
ADMIN_LOGIN=troque-isto
ADMIN_SENHA=troque-isto
