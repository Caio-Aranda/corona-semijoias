# Copie este arquivo para ".env" e troque os valores.
# O arquivo ".env" nunca vai para o Git. Todos os valores abaixo são falsos, só de exemplo.

# --- Banco de dados (PostgreSQL) ---

# Onde o banco está. Em desenvolvimento, é o container do Docker neste computador.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=corona

# ATENÇÃO: não use o caractere $ nas senhas. O Docker Compose lê $ como início de variável e a
# senha chega cortada ao banco, sem nenhum erro. Evite também a barra invertida e aspas. Use letras, números e - _ .

# Administrador do container do PostgreSQL. Usado só na criação inicial do banco.
POSTGRES_USER=troque-isto
POSTGRES_PASSWORD=troque-isto

# Usuário das migrações (Flyway). É o dono do schema: cria e altera tabelas.
DB_MIGRACAO_USER=troque-isto
DB_MIGRACAO_PASSWORD=troque-isto

# Usuário da aplicação (API). Não é superusuário e tem limite de 60 segundos por transação.
DB_APP_USER=troque-isto
DB_APP_PASSWORD=troque-isto

# --- Segurança ---

# Chaves que assinam os tokens de acesso (JWT, HS256). Cada chave tem um nome curto (ID, de 1 a 40
# letras sem acento, números, ponto, hífen ou sublinhado) e um valor aleatório de pelo menos 32 bytes,
# escrito em Base64. Sem a chave atual válida, a API não sobe e explica o que falta.
# Para gerar um valor:
#   Linux, macOS ou Git Bash:  openssl rand -base64 32
#   PowerShell:  [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
JWT_CHAVE_ATUAL_ID=chave-1
JWT_CHAVE_ATUAL=troque-isto

# Chave anterior: só durante a troca de chave. Para trocar sem derrubar ninguém: copie a atual para cá
# (ID e valor), gere uma atual nova com outro ID, suba a API, espere 15 minutos (a validade do token)
# e depois apague as duas linhas abaixo. Fora da troca, deixe as duas vazias.
JWT_CHAVE_ANTERIOR_ID=
JWT_CHAVE_ANTERIOR=

# --- Primeiro administrador ---

# Conta da dona criada na primeira vez que a API sobe sem nenhum administrador no banco.
# Enquanto não existir administrador, as três são obrigatórias (a API não sobe sem elas). Depois de
# criado, elas não são mais lidas: a senha pode sair do .env do servidor.
# Na primeira entrada ela precisa trocar esta senha (a troca obrigatória chega na tarefa 10).
ADMIN_NOME=troque-isto
ADMIN_LOGIN=troque-isto
ADMIN_SENHA=troque-isto
